{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baypeline.github.io/solana-compliance-lab/contracts/schemas/experiment.schema.json",
  "title": "experiment",
  "$comment": "Draft v2.1 기반 계약 초안 0.1.0. 배포된 API 구현을 의미하지 않습니다.",
  "$defs": {
    "GatewayRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "experimentId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "transferRequest": {
          "$ref": "policy.schema.json#/$defs/TransferRequest"
        },
        "complianceDecision": {
          "$ref": "policy.schema.json#/$defs/ComplianceDecision"
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "routeId": {
                "$ref": "common.schema.json#/$defs/Id"
              },
              "appliesPolicy": {
                "type": "boolean"
              },
              "userConfirmedWarning": {
                "type": "boolean"
              }
            },
            "required": [
              "routeId",
              "appliesPolicy",
              "userConfirmedWarning"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "schemaVersion",
        "experimentId",
        "transferRequest",
        "complianceDecision",
        "routes"
      ]
    },
    "GatewayRouteResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routeId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "policyApplied": {
          "type": "boolean"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "SUBMITTED",
            "REJECTED",
            "AWAITING_CONFIRMATION",
            "HELD_FOR_REVIEW"
          ]
        },
        "reasonCode": {
          "type": "string",
          "enum": [
            "POLICY_ALLOW",
            "POLICY_BLOCK",
            "POLICY_REVIEW",
            "WARNING_CONFIRMATION_REQUIRED",
            "WARNING_CONFIRMED",
            "POLICY_NOT_APPLIED"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "routeId",
        "policyApplied",
        "outcome",
        "reasonCode",
        "message"
      ]
    },
    "GatewayExperimentResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "experimentId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "transferRequestId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "decisionId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "executionMode": {
          "const": "SIMULATION_ONLY"
        },
        "executedAt": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "experiment.schema.json#/$defs/GatewayRouteResult"
          },
          "minItems": 1
        },
        "networkSubmitted": {
          "const": false
        }
      },
      "required": [
        "schemaVersion",
        "experimentId",
        "transferRequestId",
        "decisionId",
        "executionMode",
        "executedAt",
        "routes",
        "networkSubmitted"
      ]
    },
    "SimulationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "simulationId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "transferRequestId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "modelVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "assumptionsVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "proposers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "proposerId": {
                "$ref": "common.schema.json#/$defs/Id"
              },
              "acceptsTransaction": {
                "type": "boolean"
              }
            },
            "required": [
              "proposerId",
              "acceptsTransaction"
            ]
          },
          "minItems": 1
        },
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "conditionSatisfied": {
              "type": "boolean"
            },
            "assumption": {
              "type": "string",
              "minLength": 1,
              "description": "독립적인 증명 조건 입력. 제안자 수만으로 도출하지 않습니다."
            }
          },
          "required": [
            "conditionSatisfied",
            "assumption"
          ]
        },
        "leaderAttemptsExclusion": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "simulationId",
        "transferRequestId",
        "modelVersion",
        "assumptionsVersion",
        "proposers",
        "proof",
        "leaderAttemptsExclusion"
      ]
    },
    "ConstellationSimulationResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "simulationId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "transferRequestId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "modelVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "assumptionsVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "executionMode": {
          "const": "SIMULATION_ONLY"
        },
        "executedAt": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "acceptingProposerCount": {
          "type": "integer",
          "minimum": 0
        },
        "rejectingProposerCount": {
          "type": "integer",
          "minimum": 0
        },
        "alternativeSubmissionPathExists": {
          "type": "boolean"
        },
        "proofConditionSatisfied": {
          "type": "boolean"
        },
        "inclusionForced": {
          "type": "boolean"
        },
        "leaderCanExclude": {
          "type": "boolean"
        },
        "singleLeaderCanExclude": {
          "const": true
        },
        "reasonCode": {
          "type": "string",
          "enum": [
            "NO_ACCEPTING_PROPOSER",
            "PROOF_NOT_SATISFIED",
            "PROOF_SATISFIED"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "networkSubmitted": {
          "const": false
        }
      },
      "required": [
        "schemaVersion",
        "simulationId",
        "transferRequestId",
        "modelVersion",
        "assumptionsVersion",
        "executionMode",
        "executedAt",
        "acceptingProposerCount",
        "rejectingProposerCount",
        "alternativeSubmissionPathExists",
        "proofConditionSatisfied",
        "inclusionForced",
        "leaderCanExclude",
        "singleLeaderCanExclude",
        "reasonCode",
        "limitations",
        "networkSubmitted"
      ]
    }
  }
}
