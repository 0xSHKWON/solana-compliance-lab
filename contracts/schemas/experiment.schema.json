{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baypeline.github.io/solana-compliance-lab/contracts/schemas/experiment.schema.json",
  "title": "experiment",
  "$comment": "Unified team specifications; initial draft 0.1.0.",
  "$defs": {
    "GatewayRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routeId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "policyEnforced": {
          "type": "boolean"
        },
        "warningAcknowledged": {
          "type": "boolean"
        }
      },
      "required": [
        "routeId",
        "policyEnforced",
        "warningAcknowledged"
      ]
    },
    "GatewayExperimentRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "intent": {
          "$ref": "policy.schema.json#/$defs/TransactionIntent"
        },
        "decision": {
          "$ref": "policy.schema.json#/$defs/ComplianceDecision"
        },
        "route": {
          "$ref": "experiment.schema.json#/$defs/GatewayRoute"
        }
      },
      "required": [
        "requestId",
        "intent",
        "decision",
        "route"
      ]
    },
    "GatewayReason": {
      "type": "string",
      "enum": [
        "POLICY_NOT_ENFORCED",
        "POLICY_ALLOW",
        "POLICY_BLOCK",
        "POLICY_REVIEW",
        "WARNING_NOT_ACKNOWLEDGED",
        "WARNING_ACKNOWLEDGED"
      ]
    },
    "GatewayExperimentResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "experimentId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "intentId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "routeId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "SUBMISSION_ALLOWED",
            "SUBMISSION_REJECTED",
            "REVIEW_REQUIRED"
          ]
        },
        "policyApplied": {
          "type": "boolean"
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "$ref": "experiment.schema.json#/$defs/GatewayReason"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "actualBroadcast": {
          "const": false
        }
      },
      "required": [
        "schemaVersion",
        "experimentId",
        "intentId",
        "routeId",
        "outcome",
        "policyApplied",
        "reasonCodes",
        "actualBroadcast"
      ]
    },
    "ConstellationScenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposerCount": {
          "type": "integer",
          "minimum": 1
        },
        "rejectingProposerCount": {
          "type": "integer",
          "minimum": 0
        },
        "submittedToAcceptingProposer": {
          "type": "boolean"
        },
        "psliceAvailable": {
          "type": "boolean"
        },
        "attestationPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "leaderAttemptsExclusion": {
          "type": "boolean"
        }
      },
      "required": [
        "proposerCount",
        "rejectingProposerCount",
        "submittedToAcceptingProposer",
        "psliceAvailable",
        "attestationPercent",
        "leaderAttemptsExclusion"
      ]
    },
    "ConstellationSimulationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "intentId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "decisionId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "protocolModelVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scenario": {
          "$ref": "experiment.schema.json#/$defs/ConstellationScenario"
        }
      },
      "required": [
        "requestId",
        "intentId",
        "decisionId",
        "protocolModelVersion",
        "scenario"
      ]
    },
    "SimulationExplanation": {
      "type": "string",
      "enum": [
        "NO_ACCEPTING_PROPOSER",
        "NOT_SUBMITTED_TO_ACCEPTING_PROPOSER",
        "PSLICE_UNAVAILABLE",
        "ATTESTATION_CONDITION_NOT_MET",
        "ATTESTATION_CONDITION_MET",
        "LEADER_EXCLUSION_VALID",
        "LEADER_EXCLUSION_INVALID",
        "NO_EXCLUSION_ATTEMPT",
        "REJECTING_COUNT_EXCEEDS_TOTAL",
        "CONTRADICTORY_SUBMISSION_PATH",
        "MOCK_RESULT_NOT_PROTOCOL_VALIDATED"
      ]
    },
    "ConstellationSimulationResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "simulationId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "intentId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "protocolModelVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "proposerPathAvailable": {
          "type": "boolean"
        },
        "psliceInclusionEnforced": {
          "type": "boolean"
        },
        "leaderExclusionValid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "NO_SUBMISSION_PATH",
            "INCLUSION_NOT_ENFORCED",
            "INCLUSION_ENFORCED",
            "INVALID_SCENARIO"
          ]
        },
        "explanationCodes": {
          "type": "array",
          "items": {
            "$ref": "experiment.schema.json#/$defs/SimulationExplanation"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "simulationOnly": {
          "const": true
        }
      },
      "required": [
        "schemaVersion",
        "simulationId",
        "intentId",
        "protocolModelVersion",
        "proposerPathAvailable",
        "psliceInclusionEnforced",
        "leaderExclusionValid",
        "outcome",
        "explanationCodes",
        "simulationOnly"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "INCLUSION_ENFORCED"
              }
            }
          },
          "then": {
            "properties": {
              "proposerPathAvailable": {
                "const": true
              },
              "psliceInclusionEnforced": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "NO_SUBMISSION_PATH"
              }
            }
          },
          "then": {
            "properties": {
              "proposerPathAvailable": {
                "const": false
              },
              "psliceInclusionEnforced": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "INCLUSION_NOT_ENFORCED"
              }
            }
          },
          "then": {
            "properties": {
              "psliceInclusionEnforced": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "INVALID_SCENARIO"
              }
            }
          },
          "then": {
            "properties": {
              "proposerPathAvailable": {
                "const": false
              },
              "psliceInclusionEnforced": {
                "const": false
              },
              "leaderExclusionValid": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
