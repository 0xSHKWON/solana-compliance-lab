{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baypeline.github.io/solana-compliance-lab/contracts/schemas/api.schema.json",
  "title": "api",
  "$comment": "Unified team specifications; initial draft 0.1.0.",
  "$defs": {
    "AnalysisRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "network": {
          "$ref": "common.schema.json#/$defs/Network"
        },
        "mode": {
          "$ref": "common.schema.json#/$defs/Mode"
        },
        "fixtureId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "rulesetVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        }
      },
      "required": [
        "address",
        "network",
        "mode",
        "scope"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "FIXTURE"
              }
            }
          },
          "then": {
            "required": [
              "fixtureId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "LIVE"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "fixtureId"
              ]
            }
          }
        }
      ]
    },
    "AnalysisAccepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "analysisId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "requestId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "status": {
          "const": "QUEUED"
        }
      },
      "required": [
        "schemaVersion",
        "analysisId",
        "requestId",
        "status"
      ]
    },
    "KYTAnalysisResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "analysisId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "requestId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/JobStatus"
        },
        "address": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "network": {
          "$ref": "common.schema.json#/$defs/Network"
        },
        "mode": {
          "$ref": "common.schema.json#/$defs/Mode"
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "updatedAt": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "snapshotId": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "collector.schema.json#/$defs/Coverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataProvenance": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/DataProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluation": {
          "anyOf": [
            {
              "$ref": "kyt.schema.json#/$defs/KYTEvaluation"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "analysisId",
        "requestId",
        "status",
        "address",
        "network",
        "mode",
        "createdAt",
        "updatedAt",
        "snapshotId",
        "coverage",
        "dataProvenance",
        "evaluation",
        "error"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "QUEUED",
                  "RUNNING"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "snapshotId": {
                "type": "null"
              },
              "coverage": {
                "type": "null"
              },
              "dataProvenance": {
                "type": "null"
              },
              "evaluation": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "COMPLETED",
                  "PARTIAL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "snapshotId": {
                "$ref": "common.schema.json#/$defs/Id"
              },
              "coverage": {
                "$ref": "collector.schema.json#/$defs/Coverage"
              },
              "dataProvenance": {
                "$ref": "common.schema.json#/$defs/DataProvenance"
              },
              "evaluation": {
                "$ref": "kyt.schema.json#/$defs/KYTEvaluation"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "COMPLETED"
              }
            }
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "status": {
                    "const": "COMPLETE"
                  }
                }
              },
              "evaluation": {
                "properties": {
                  "riskScore": {
                    "type": "integer"
                  },
                  "riskLevel": {
                    "$ref": "common.schema.json#/$defs/RiskLevel"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PARTIAL"
              }
            }
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "status": {
                    "const": "PARTIAL"
                  }
                }
              },
              "evaluation": {
                "properties": {
                  "riskScore": {
                    "type": "null"
                  },
                  "riskLevel": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "common.schema.json#/$defs/Error"
              },
              "snapshotId": {
                "type": "null"
              },
              "coverage": {
                "type": "null"
              },
              "dataProvenance": {
                "type": "null"
              },
              "evaluation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "TransferPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "analysisId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "snapshotId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "collector.schema.json#/$defs/NormalizedTransfer"
          }
        },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "nextCursor": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/Id"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "limit",
            "nextCursor"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "analysisId",
        "snapshotId",
        "items",
        "pagination"
      ]
    },
    "ComplianceRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent": {
          "$ref": "policy.schema.json#/$defs/TransactionIntent"
        },
        "senderAnalysisId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "recipientAnalysisId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "policyVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        }
      },
      "required": [
        "intent",
        "senderAnalysisId",
        "recipientAnalysisId",
        "policyVersion"
      ]
    },
    "ComplianceResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "requestId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "intent": {
          "$ref": "policy.schema.json#/$defs/TransactionIntent"
        },
        "assessments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sender": {
              "$ref": "kyt.schema.json#/$defs/KYTEvaluation"
            },
            "recipient": {
              "$ref": "kyt.schema.json#/$defs/KYTEvaluation"
            }
          },
          "required": [
            "sender",
            "recipient"
          ]
        },
        "decision": {
          "$ref": "policy.schema.json#/$defs/ComplianceDecision"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "intent",
        "assessments",
        "decision"
      ]
    },
    "GatewayRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intentId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "decisionId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "route": {
          "$ref": "experiment.schema.json#/$defs/GatewayRoute"
        }
      },
      "required": [
        "intentId",
        "decisionId",
        "route"
      ]
    },
    "ConstellationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intentId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "decisionId": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "protocolModelVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "scenario": {
          "$ref": "experiment.schema.json#/$defs/ConstellationScenario"
        }
      },
      "required": [
        "intentId",
        "decisionId",
        "protocolModelVersion",
        "scenario"
      ]
    }
  }
}
