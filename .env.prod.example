# Copy to .env.prod and set the Collector address reachable from containers.
COLLECTOR_URL=http://collector.example.internal:8000
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=https://compliance.example.com
DEFAULT_RULESET_VERSION=1.0.0
CONSTELLATION_ATTESTATION_THRESHOLD=66.67
